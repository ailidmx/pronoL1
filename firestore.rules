rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && (request.auth.token.admin == true
          || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true));
    }

    function isOwnUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwnUser(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Product entitlement configuration. Signed-in clients may read access
    // plans so their UI reacts to admin changes; only admins may mutate them.
    match /accessPlans/{planId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /subscriptionOffers/{offerId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /competitions/{competitionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /competitionSeasons/{competitionSeasonId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /standings/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /clubs/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /seasons/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /matches/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /matches/{matchId}/pronostics/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /leaderboardPronostics/{seasonId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /leaderboardPronostics/{seasonId}/rows/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /bonus/{seasonId}/questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /bonus/{seasonId}/answers/{userId} {
      allow read: if isOwnUser(userId) || isAdmin();
      allow write: if false;
    }

    match /quizWeeks/{weekId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /quizWeeks/{weekId}/questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /quizWeeks/{weekId}/questions/{questionId}/options/{optionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /quizWeeks/{weekId}/questions/{questionId}/answers/{userId} {
      allow read: if isOwnUser(userId) || isAdmin();
      allow write: if false;
    }

    match /pushSubscriptions/{subscriptionId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /pushRappels/{doc} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
