{
  "name": "@prono-l1/functions",
  "version": "1.0.0",
  "description": "Prono-L1 Cloud Functions (Phase 2 backend)",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "esbuild index.js --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js --external:firebase-admin --external:firebase-functions --external:web-push",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@prono-l1/domain": "1.0.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
